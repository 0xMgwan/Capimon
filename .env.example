# Optional. Both default to the public Base endpoint (https://mainnet.base.org),
# which is rate-limited — set a dedicated RPC for anything beyond local use.

# Server-side reads: market data, portfolio, quotes, token metadata.
BASE_RPC_URL=

# Browser-side reads and transaction sending via wagmi.
NEXT_PUBLIC_BASE_RPC_URL=

# Canonical origin, used for canonical links and social share images.
# Set this once a custom domain is live (e.g. https://capimon.xyz).
# WalletConnect (Reown) project id, free from dashboard.reown.com.
# Only Phantom needs it: Coinbase and MetaMask reach their apps through their
# own SDKs. Without it, Phantom on a phone falls back to its own browser.
# What the scheduler sends as its bearer token. Any random string; Vercel
# passes it automatically once it exists. Without it the scheduler calls with
# no credentials, and the jobs are recognised by the platform's own marker
# instead — set it anyway, it is the documented path.
CRON_SECRET=

# Web push. Generate a pair with:  npx web-push generate-vapid-keys
# The public key is sent to the browser by design; the private one is not.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Where a push service should complain if something is wrong with our sends.
VAPID_SUBJECT=mailto:refitanzania@gmail.com

# A second nTZS account holding nothing but the broker's share of the fees.
# It opens on CAPX's own identity: every field below falls back to the
# NTZS_OMNIBUS_* one, so only the external id has to differ. Without an
# omnibus identity configured their fees stay in the omnibus and withdrawals
# are paid from there — nothing breaks, the separation just does not happen.
# nTZS links one NIDA to one wallet, so the fee account needs an identity of
# its own — the omnibus number is already spoken for. Set the NIDA and the
# phone that belongs with it; everything else still falls back to the omnibus.
NTZS_BROKER_NIDA=
NTZS_BROKER_PHONE=
# Bump this when the identity changes: upstream is idempotent on the external
# id, so an account it has already refused is upgraded rather than replaced,
# and a fresh id provisions cleanly instead.
NTZS_BROKER_EXTERNAL_ID=capx-broker-fees
# Set this once the account has its wallet, to skip provisioning every boot.
NTZS_BROKER_USER_ID=

# The broker's cut of the trade fee, in basis points, out of FEE_BPS.
BROKER_FEE_BPS=100

NEXT_PUBLIC_WC_PROJECT_ID=

NEXT_PUBLIC_SITE_URL=

# Platform fee, in basis points, taken by the router inside each swap.
# Defaults to 20 (0.20%) in code, so this only needs setting to change it.
# FEE_BPS=0 switches the fee off without a deploy. Capped at 100 (1%).
FEE_BPS=

# Where the fee is paid. Defaults to the address baked into src/lib/fees.ts.
FEE_RECEIVER=

# nTZS partner API — the Tanzanian shilling on-ramp. Server-side only; this key
# must never reach the browser. Start with an ntzs_test_ key: test mode mirrors
# the live endpoints with simulated money, identity and payment rails.
# Requires the `wallets`, `collections` and `swap` capabilities on your account.
NTZS_API_KEY=
NTZS_BASE_URL=

# Signs the webhooks nTZS sends back, shown once when the account is created
# and rotatable from the same page in their dashboard. Set the delivery URL
# there to https://<this deployment>/api/ntzs/webhook.
#
# Without it that route refuses every delivery, deliberately — a missing
# secret must mean "accept nothing", never "skip the check" — and deposits
# are credited by the ten-minute sweep as they always were. With it, a
# collection is credited when nTZS says it minted, which is the only thing
# that notices a bank transfer sent while nobody was polling.
NTZS_WEBHOOK_SECRET=

# The single nTZS account every user deposit collects into. Left blank, CAPX
# provisions one on first use with externalId "capx-omnibus" — idempotent, so it
# can never create a second. Set it explicitly to pin an existing account.
NTZS_OMNIBUS_USER_ID=
NTZS_OMNIBUS_EMAIL=

# --- Custodial accounts (nTZS / shilling users) -----------------------------
# Postgres for the custodial ledger. Any provider works (Neon, Supabase,
# Vercel Postgres). Without it, custodial features report "not configured" and
# self-custody wallet trading is unaffected.
DATABASE_URL=

# The omnibus treasury key that holds client assets and signs their trades.
# An environment variable is the weakest acceptable home for a key controlling
# other people's money — move this behind a KMS or HSM before it holds real
# balances. Never commit it, never log it, rotate it if it is ever exposed.
TREASURY_PRIVATE_KEY=

# Unlocks the per-asset solvency breakdown at /api/solvency. Without it that
# route reports only whether client assets are backed, which is public by design.
ADMIN_TOKEN=

# Email notices over SMTP. A Gmail address with an app password works as it is.
# Without these, notices are skipped and logged rather than failing anything.
SMTP_USER=
SMTP_PASS=
# Defaults to Gmail. Set both for another provider; 465 is implicit TLS, 587 STARTTLS.
SMTP_HOST=
SMTP_PORT=
# Sender. With Gmail this must be the account itself; defaults to SMTP_USER.
MAIL_FROM=
# Where KYC and other operational notices go. Defaults to SMTP_USER.
OPS_EMAIL=

# Idle-dollar yield: supplies treasury USDC above the buffer to Aave v4 on Base
# (the "Coinbase Stocks" spoke, USDC reserve 7). Off unless set to "on" — the
# position is always *read* so solvency counts it, but nothing is supplied
# until a deployment opts in. The buffer stays on-chain so an ordinary order
# never has to unwind anything to settle.
AAVE_YIELD=off
AAVE_YIELD_BUFFER=25

# Crediting a small stablecoin deposit before its block is safe.
# The money is in the omnibus either way — this only skips the one-to-three
# minute wait for the batch to reach Ethereum. Two ceilings bound it: the most
# any one deposit may be credited early, and (times EXPOSURE) the most that may
# be credited early and unsettled at once. Set either cap to 0 to turn the fast
# path off for that token. An early credit is reversed out of the ledger if its
# transaction is reorged out before it goes safe.
INSTANT_CREDIT_USDC=25
INSTANT_CREDIT_TZS=60000
INSTANT_CREDIT_EXPOSURE=4

# The DSE's CSD stakeholder API: live custody, and pledging shares.
# Server-only — these are the credentials the exchange issued, never NEXT_PUBLIC_.
# Absent, dseCustodyConfigured is false and every call refuses rather than
# pretending; nothing else in the app changes.
# UAT is https://api-uat.tz-exchange.co.tz — production is issued after sign-off.
DSE_CSD_BASE_URL=
# Four credentials, named as the exchange's own environment names them:
# an application identity and a stakeholder user identity.
DSE_CSD_APPLICATION_ID=
DSE_CSD_ACCESS_SECRET=
DSE_CSD_STAKEHOLDER_USERNAME=
DSE_CSD_STAKEHOLDER_PASSWORD=
# Only if their token endpoint moves from /iam/api/v1/stakeholders/oauth/token.
DSE_CSD_TOKEN_PATH=
# CAPX's own BPID: the party receiving a pledge.
DSE_CSD_BPID=

# The chain leg of a settled trade. Off unless this is exactly "on".
# Dispatch signs with the treasury key — the same key that mints, prices and
# holds the float — so switching it on is a deliberate act after the signing
# split, never a side effect of deploying. With it off the queue still fills
# and the desk still shows what would be sent.
SETTLEMENT_DISPATCH=

# Route a DSE order to whichever maker can fill it, rather than always the
# treasury. Off unless exactly "on". Routing changes which account is paid on
# every trade, so turn it on against a real book with a funded provider, not
# by deploying. With it off, orders take the path they always took.
ORDER_ROUTING=
