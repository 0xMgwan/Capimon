# Optional. Both default to the public Base endpoint (https://mainnet.base.org),
# which is rate-limited — set a dedicated RPC for anything beyond local use.

# Server-side reads: market data, portfolio, quotes, token metadata.
BASE_RPC_URL=

# Browser-side reads and transaction sending via wagmi.
NEXT_PUBLIC_BASE_RPC_URL=

# Canonical origin, used for canonical links and social share images.
# Set this once a custom domain is live (e.g. https://capimon.xyz).
# WalletConnect (Reown) project id, free from dashboard.reown.com.
# Only Phantom needs it: Coinbase and MetaMask reach their apps through their
# own SDKs. Without it, Phantom on a phone falls back to its own browser.
# Web push. Generate a pair with:  npx web-push generate-vapid-keys
# The public key is sent to the browser by design; the private one is not.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Where a push service should complain if something is wrong with our sends.
VAPID_SUBJECT=mailto:refitanzania@gmail.com

NEXT_PUBLIC_WC_PROJECT_ID=

NEXT_PUBLIC_SITE_URL=

# Platform fee, in basis points, taken by the router inside each swap.
# Defaults to 20 (0.20%) in code, so this only needs setting to change it.
# FEE_BPS=0 switches the fee off without a deploy. Capped at 100 (1%).
FEE_BPS=

# Where the fee is paid. Defaults to the address baked into src/lib/fees.ts.
FEE_RECEIVER=

# nTZS partner API — the Tanzanian shilling on-ramp. Server-side only; this key
# must never reach the browser. Start with an ntzs_test_ key: test mode mirrors
# the live endpoints with simulated money, identity and payment rails.
# Requires the `wallets`, `collections` and `swap` capabilities on your account.
NTZS_API_KEY=
NTZS_BASE_URL=

# The single nTZS account every user deposit collects into. Left blank, CAPX
# provisions one on first use with externalId "capx-omnibus" — idempotent, so it
# can never create a second. Set it explicitly to pin an existing account.
NTZS_OMNIBUS_USER_ID=
NTZS_OMNIBUS_EMAIL=

# --- Custodial accounts (nTZS / shilling users) -----------------------------
# Postgres for the custodial ledger. Any provider works (Neon, Supabase,
# Vercel Postgres). Without it, custodial features report "not configured" and
# self-custody wallet trading is unaffected.
DATABASE_URL=

# The omnibus treasury key that holds client assets and signs their trades.
# An environment variable is the weakest acceptable home for a key controlling
# other people's money — move this behind a KMS or HSM before it holds real
# balances. Never commit it, never log it, rotate it if it is ever exposed.
TREASURY_PRIVATE_KEY=

# Unlocks the per-asset solvency breakdown at /api/solvency. Without it that
# route reports only whether client assets are backed, which is public by design.
ADMIN_TOKEN=

# Email notices over SMTP. A Gmail address with an app password works as it is.
# Without these, notices are skipped and logged rather than failing anything.
SMTP_USER=
SMTP_PASS=
# Defaults to Gmail. Set both for another provider; 465 is implicit TLS, 587 STARTTLS.
SMTP_HOST=
SMTP_PORT=
# Sender. With Gmail this must be the account itself; defaults to SMTP_USER.
MAIL_FROM=
# Where KYC and other operational notices go. Defaults to SMTP_USER.
OPS_EMAIL=
