# Copy to contracts/.env and fill in. Never committed — .env is gitignored.

# The account that will PERMANENTLY own CRDBt. createB20 derives the token
# address from this sender, so it cannot be changed afterwards. Keep it
# separate from the trading treasury: that one is a hot key in a Vercel env
# var and signs customer orders all day.
ISSUER_PRIVATE_KEY=0x...

BASE_SEPOLIA_RPC=https://sepolia.base.org
BASE_MAINNET_RPC=https://mainnet.base.org
